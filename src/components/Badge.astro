---
type Variant =
	| 'default'
	| 'secondary'
	| 'outline'
	| 'feature'
	| 'improvement'
	| 'fix'
	| 'breaking'
	| 'muted';

const {
	variant = 'default',
	class: className = '',
} = Astro.props as { variant?: Variant; class?: string };

const base =
	'inline-flex items-center justify-center rounded-full border px-2 py-0.5 text-[11px] font-medium leading-none whitespace-nowrap select-none';

// Uncolored badges for now: keep everything in a single primary/default style.
const variants: Record<string, string> = {
	default: 'border-white/12 bg-white/5 text-zinc-200',
	secondary: 'border-white/12 bg-white/5 text-zinc-200',
	outline: 'border-white/12 bg-transparent text-zinc-200',
	feature: 'border-white/12 bg-white/5 text-zinc-200',
	improvement: 'border-white/12 bg-white/5 text-zinc-200',
	fix: 'border-white/12 bg-white/5 text-zinc-200',
	breaking: 'border-white/12 bg-white/5 text-zinc-200',
	muted: 'border-white/12 bg-white/5 text-zinc-200',
};

const cls = `${base} ${variants[variant] ?? variants.default} ${className}`.trim();
---

<span class={cls} data-variant={variant}>
	<slot />
</span>
