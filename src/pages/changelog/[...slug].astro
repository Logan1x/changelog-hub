---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
	const entries = await getCollection('changelog');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: entry,
	}));
}

type Props = CollectionEntry<'changelog'>;

const entry: Props = Astro.props;
const { Content } = await render(entry);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={entry.data.title} description={entry.data.summary ?? entry.data.title} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-4 py-10">
			<a href="/changelog" class="text-sm text-zinc-400 hover:text-zinc-200">← Back</a>

			<header class="mt-5 rounded-2xl border border-white/10 bg-ink-900/40 p-6">
				<h1 class="text-2xl font-semibold tracking-tight">{entry.data.title}</h1>
				<div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-zinc-500">
					<span><FormattedDate date={entry.data.date} /></span>
					{entry.data.week ? <span>• {entry.data.week}</span> : null}
					{entry.data.author ? <span>• {entry.data.author}</span> : null}
					<span class="rounded-full border border-white/10 bg-white/5 px-2 py-0.5 text-[11px] text-zinc-300">{entry.data.project}</span>
				</div>
				{entry.data.summary ? <p class="mt-4 text-sm text-zinc-400">{entry.data.summary}</p> : null}
			</header>

			{(entry.data.changes || []).length ? (
				<section class="mt-6 rounded-2xl border border-white/10 bg-ink-900/30 p-6">
					<h2 class="text-sm font-semibold text-zinc-100">Highlights</h2>
					<ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-zinc-300">
						{(entry.data.changes || []).map((c) => (
							<li>
								<div class="flex flex-wrap items-center gap-2">
									{c.type ? (
										<span class="rounded-full border border-white/10 bg-white/5 px-2 py-0.5 text-[11px] text-zinc-300">{c.type}</span>
									) : null}
									<span class="font-medium text-zinc-100">{c.title}</span>
								</div>
								{c.description ? <div class="mt-1 text-zinc-400">{c.description}</div> : null}
							</li>
						))}
					</ul>
				</section>
			) : null}

			<article class="prose prose-invert mt-6 max-w-none prose-headings:scroll-mt-24 prose-a:text-emerald-300 prose-a:no-underline hover:prose-a:text-emerald-200">
				<Content />
			</article>
		</main>
		<Footer />
	</body>
</html>
