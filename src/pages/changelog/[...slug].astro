---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
	const entries = await getCollection('changelog');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: entry,
	}));
}

type Props = CollectionEntry<'changelog'>;

const entry: Props = Astro.props;
const { Content } = await render(entry);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={entry.data.title} description={entry.data.summary ?? entry.data.title} />
	</head>
	<body>
		<Header />
		<main>
			<a class="back" href="/changelog">← Back to changelog</a>
			<header class="hero">
				<h1>{entry.data.title}</h1>
				<p class="meta">
					<FormattedDate date={entry.data.date} />
					{entry.data.week ? <span class="dot">•</span> : null}
					{entry.data.week ? <span>{entry.data.week}</span> : null}
				</p>
				{entry.data.summary ? <p class="summary">{entry.data.summary}</p> : null}
			</header>

			<article class="content">
				<Content />
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 860px;
		margin: 0 auto;
		padding: 2rem 1rem 3rem;
	}
	.back {
		display: inline-block;
		color: rgb(var(--accent));
		text-decoration: none;
		margin-bottom: 1.25rem;
	}
	.hero h1 {
		margin: 0;
		font-size: 2.1rem;
		line-height: 1.15;
	}
	.meta {
		margin: 0.5rem 0 0;
		color: rgb(var(--gray));
		display: flex;
		gap: 0.5rem;
		align-items: center;
		flex-wrap: wrap;
	}
	.dot {
		opacity: 0.6;
	}
	.summary {
		margin: 0.85rem 0 0;
		color: rgba(var(--black), 0.72);
		font-size: 1.05rem;
	}
	.content :global(h2) {
		margin-top: 1.75rem;
	}
	.content {
		margin-top: 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(var(--gray), 0.2);
	}
</style>
