---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const entries = (await getCollection('changelog')).sort(
	(a, b) => (b.data.date?.valueOf?.() ?? 0) - (a.data.date?.valueOf?.() ?? 0),
);

function tone(type) {
	if (type === 'feature') return 'border-emerald-500/30 bg-emerald-500/10 text-emerald-200';
	if (type === 'improvement') return 'border-sky-500/30 bg-sky-500/10 text-sky-200';
	if (type === 'fix') return 'border-amber-500/30 bg-amber-500/10 text-amber-200';
	if (type === 'breaking') return 'border-rose-500/30 bg-rose-500/10 text-rose-200';
	return 'border-white/10 bg-white/5 text-zinc-300';
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — Changelog`} description="Weekly changelogs" />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-5xl px-4 py-10">
			<div class="flex items-end justify-between gap-4">
				<div>
					<h1 class="text-2xl font-semibold tracking-tight">Changelog</h1>
					<p class="mt-1 text-sm text-zinc-400">Weekly releases generated from commit history.</p>
				</div>
				<div class="text-xs text-zinc-500">{entries.length} entries</div>
			</div>

			<div class="mt-6 grid gap-3">
				{entries.length ? (
					entries.map((e) => (
						<a
							class="group rounded-2xl border border-white/10 bg-ink-900/40 p-5 hover:border-white/15 hover:bg-ink-900/60"
							href={`/changelog/${e.id}/`}
						>
							<div class="flex items-start justify-between gap-4">
								<div class="min-w-0">
									<div class="flex flex-wrap items-center gap-2">
										<h2 class="truncate text-base font-semibold text-zinc-100 group-hover:text-white">
											{e.data.title}
										</h2>
										{e.data.isMajor ? (
											<span class="rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2 py-0.5 text-[11px] text-emerald-200">
												Major
											</span>
										) : null}
									</div>
									<div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-zinc-500">
										<span><FormattedDate date={e.data.date} /></span>
										{e.data.week ? <span>• {e.data.week}</span> : null}
									</div>
									{e.data.summary ? (
										<p class="mt-3 text-sm text-zinc-400">{e.data.summary}</p>
									) : null}
								</div>
							</div>

							<div class="mt-4 flex flex-wrap gap-2">
								{(e.data.changes || []).slice(0, 6).map((c) => (
									<span class={`rounded-full border px-2 py-0.5 text-[11px] ${tone(c.type)}`}>
										{c.type || 'change'}
									</span>
								))}
								{(e.data.changes || []).length > 6 ? (
									<span class="rounded-full border border-white/10 bg-white/5 px-2 py-0.5 text-[11px] text-zinc-300">
										+{(e.data.changes || []).length - 6}
									</span>
								) : null}
							</div>
						</a>
					))
				) : (
					<div class="rounded-2xl border border-dashed border-white/10 p-10 text-center text-sm text-zinc-500">
						No changelog entries yet.
					</div>
				)}
			</div>
		</main>
		<Footer />
	</body>
</html>
