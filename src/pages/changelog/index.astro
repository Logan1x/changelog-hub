---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Badge from '../../components/Badge.astro';
import { SITE_TITLE } from '../../consts';
import { PROJECTS } from '../../projects';

const entriesAll = await getCollection('changelog');
const project = Astro.url.searchParams.get('project') || 'all';

const entries = entriesAll
	.filter((e) => (project === 'all' ? true : e.data.project === project))
	.sort((a, b) => (b.data.date?.valueOf?.() ?? 0) - (a.data.date?.valueOf?.() ?? 0));

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — Changelog`} description="Weekly changelogs" />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-5xl px-4 py-10">
			<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<h1 class="text-2xl font-semibold tracking-tight">Changelog</h1>
					<p class="mt-1 text-sm text-zinc-400">Readable updates, grouped as bullets. Filter by project.</p>
				</div>
				<div class="text-xs text-zinc-500">{entries.length} entries</div>
			</div>

			<div class="mt-5 flex flex-wrap items-center gap-2">
				<a href="/changelog?project=all" class="no-underline">
					<Badge variant={project === 'all' ? 'default' : 'muted'} class="px-3 py-1 text-xs hover:bg-white/10">
						All
					</Badge>
				</a>
				{PROJECTS.map((p) => (
					<a href={`/changelog?project=${p.slug}`} class="no-underline">
						<Badge
							variant={project === p.slug ? 'default' : 'muted'}
							class="px-3 py-1 text-xs hover:bg-white/10"
						>
							{p.name}
						</Badge>
					</a>
				))}
			</div>

			<div class="mt-6 grid gap-3">
				{entries.length ? (
					entries.map((e) => (
						<a
							class="group rounded-2xl border border-white/10 bg-ink-900/40 p-5 hover:border-white/15 hover:bg-ink-900/60"
							href={`/changelog/${e.id}/`}
						>
							<div class="flex items-start justify-between gap-4">
								<div class="min-w-0">
									<div class="flex flex-wrap items-center gap-2">
										<h2 class="truncate text-base font-semibold text-zinc-100 group-hover:text-white">
											{e.data.title}
										</h2>
										<Badge variant="secondary">
											{PROJECTS.find((p) => p.slug === e.data.project)?.name ?? e.data.project}
										</Badge>
										{e.data.isMajor ? <Badge variant="default">Major</Badge> : null}
									</div>
									<div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-zinc-500">
										<span><FormattedDate date={e.data.date} /></span>
										{e.data.week ? <span>• {e.data.week}</span> : null}
									</div>
									{e.data.summary ? (
										<p class="mt-3 text-sm text-zinc-400">{e.data.summary}</p>
									) : null}

									{/* Bullet highlights */}
									{(e.data.changes || []).length ? (
										<ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-zinc-300">
											{(e.data.changes || []).slice(0, 4).map((c) => (
												<li>
													<span class="font-medium text-zinc-100">{c.title}</span>
													{c.description ? <span class="text-zinc-400"> — {c.description}</span> : null}
												</li>
											))}
										</ul>
									) : null}
								</div>
							</div>

							<div class="mt-4 flex flex-wrap gap-2">
								{(e.data.changes || []).slice(0, 6).map((c) => (
									<Badge variant={c.type || 'muted'}>{c.type || 'change'}</Badge>
								))}
								{(e.data.changes || []).length > 6 ? (
									<Badge variant="muted">+{(e.data.changes || []).length - 6}</Badge>
								) : null}
							</div>
						</a>
					))
				) : (
					<div class="rounded-2xl border border-dashed border-white/10 p-10 text-center text-sm text-zinc-500">
						No changelog entries yet.
					</div>
				)}
			</div>
		</main>
		<Footer />
	</body>
</html>
